set type 23 diameter 0.002
set type 23 density 0.5
pair_coeff 23 23 granular hertz/material 0 0 0.5 tangential linear_nohistory 0 0

group group_move_1 id 1 3 5 7 9
fix fix_move_1 group_move_1 move linear NULL NULL NULL

group group_move_2 id 2 4 6 8 10
fix fix_move_2 group_move_2 move linear 0 0 0
bond_coeff 1 1939.1999999999996 0.0009900990099009903
include structure/bond_1.txt
dihedral_coeff 2 3 8.297779215368911e-05 1 0.0 1 1 90 0 1 90 0 0.0006463999999999999 0 0 0 1 180.0 1 0 0 0 0.0006463999999999999 0 0 0 0 0 0 1 180.0 1
include structure/dihedral_2.txt
bond_coeff 3 2015.9999999999995 0.0009523809523809526
include structure/bond_3.txt
dihedral_coeff 4 3 8.626404134789463e-05 1 0.0 1 1 90 0 1 90 0 0.000672 0 0 0 1 180.0 1 0 0 0 0.000672 0 0 0 0 0 0 1 180.0 1
include structure/dihedral_4.txt
angle_coeff 5 0.0012927999999999991 90.0
include structure/angle_5.txt

group group_move_3 id 1 3 5 7 9 211 212 213 214 215 216 217 218 219 220 221 222 223 224 225 226 227 228 229 230 351 352 353 354 355 356 357 358 359 360 361 362 363 364 365 366 367 368 369 370 491 492 493 494 495 496 497 498 499 500 501 502 503 504 505 506 507 508 509 510 631 632 633 634 635 636 637 638 639 640 641 642 643 644 645 646 647 648 649 650 11 111 251 391 531
fix fix_move_3 group_move_3 move linear 0 0 0.001

fix fix_viscosity_1 all viscous 0.002

compute bendingE all pe/atom angle
compute stretchingE all pe/atom bond
dump pump all custom 1 raw/out*.dump id type radius x y z fx fy fz c_bendingE c_stretchingE
dump_modify pump pad 11

timestep 1e-07
dump_modify pump every 100000
run 10000000
